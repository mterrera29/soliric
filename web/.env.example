# ── Base de datos (Neon / Postgres) ──
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Login (Firebase) ──
# Cliente (variables públicas del proyecto de Firebase)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Servidor: cuenta de servicio (JSON en base64 o crudo). Firebase Console > Project Settings > Service Accounts
FIREBASE_SERVICE_ACCOUNT_KEY=

# ── Solana ──
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# Tesorería: paga las comisiones de las wallets de los usuarios y es el árbitro (JSON array de 64 bytes)
TREASURY_SECRET=
# Clave AES-256 para cifrar las wallets custodiales (32 bytes en hex): openssl rand -hex 32
WALLET_ENC_KEY=

# ── Reglas del servicio ──
# Ventana pública de impugnación en segundos (por defecto 604800 = 7 días; 0 para desarrollo)
SOLIRIC_WINDOW_SECS=604800
# UIDs de Firebase que pueden revisar y resolver disputas, separados por coma
SOLIRIC_ADMIN_UIDS=
# Uso gratuito: obras gratis por cuenta, tope por cuenta (SOL) y tope diario global (SOL)
# SOLIRIC_FREE_REGISTRATIONS=3
# SOLIRIC_USER_CAP_SOL=0.05
# SOLIRIC_DAILY_BUDGET_SOL=1
# API pública: máximo de obras por día y por app asociada
# SOLIRIC_PARTNER_DAILY_LIMIT=100

# ── Despliegue ──
# URL pública del sitio (para las vistas previas al compartir y los links de la API)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Protege /api/cron/finalize (Vercel lo envía como Bearer)
CRON_SECRET=
